{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.worker.json && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/integration/*.test.ts",
    "test:e2e:dev": "playwright test",
    "test:e2e:static": "E2E_SERVER=static playwright test",
    "test:e2e": "npm run test:e2e:dev && npm run build && npm run test:e2e:static"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/hotwired__turbo": "^8.0.16",
    "@types/node": "^24.10.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.23",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
